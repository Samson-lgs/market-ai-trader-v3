# Server-side only. Never commit real credentials.
TWELVE_DATA_API_KEY=replace_with_provider_key
# Optional production frontend origin, e.g. https://your-site.example
ALLOWED_ORIGIN=https://your-site.example
# Economic calendar provider endpoint. Keep provider credentials server-side.
CALENDAR_API_URL=https://your-calendar-provider.example/events
CALENDAR_API_KEY=replace_with_calendar_provider_key
